{
  "ingest": {
    "oscListenPort": 11001,
    "oscSendPort": 11000,
    "abletonHost": "127.0.0.1",
    "watchedTracks": [
      "DECK A",
      "DECK B",
      "DECK C",
      "DECK D"
    ],
    "authoritative": {
      "strategy": "bestMatch",
      "track": null
    }
  },
  "sim": {
    "enabled": false,
    "mode": "internal",
    "driver": "scenario",
    "scenario": "./config/scenarios/sheet-demo.json",
    "intervalSeconds": 8,
    "quantDelaySeconds": 1
  },
  "sheets": {
    "worksheet": "MASTER_v1.1",
    "headerRow": 4,
    "matchColumn": "Song Title",
    "aliasColumn": "Aliases",
    "alsFolderColumn": "ALS Folder",
    "refreshSeconds": 30,
    "cacheFile": "./data/sheet-cache.json",
    "editorColumns": {
      "BPM": { "type": "number", "step": 0.1 },
      "Cue": { "type": "icon", "true": "✅", "false": "✖" },
      "Pillar": { "type": "icon", "true": "✅", "false": "✖" },
      "RGB_1": { "type": "color" },
      "RGB_2": { "type": "color" },
      "RGB_3": { "type": "color" }
    }
  },
  "match": {
    "threshold": 0.4,
    "minConfidenceGap": 0.08,
    "normalize": {
      "lowercase": true,
      "stripPunctuation": true,
      "stripVersionTags": true
    }
  },
  "server": {
    "wsHeartbeatSeconds": 5
  },
  "timecode": {
    "enabled": false,
    "port": 6454,
    "bindAddress": "0.0.0.0",
    "staleMs": 500
  },
  "sessionLog": {
    "directory": "./data/sessions",
    "autoStart": false,
    "autoStartWhenSim": true,
    "defaultSessionName": "test"
  },
  "moments": {
    "autoStartOnMoment": true,
    "kinds": ["dope", "not_dope"],
    "debounceMs": 0
  },
  "oscOut": {
    "enabled": false,
    "destinations": []
  },
  "views": {
    "band": {
      "title": "Band",
      "fields": [
        {
          "column": "Key",
          "display": "token"
        },
        {
          "column": "Relative Key",
          "display": "token"
        },
        {
          "source": "tempo",
          "label": "Tempo",
          "display": "token"
        }
      ]
    },
    "visuals": {
      "title": "Visuals",
      "fields": [
        {
          "column": "Video World"
        },
        {
          "column": "RGB_1",
          "label": "Color 1",
          "type": "color"
        },
        {
          "column": "RGB_2",
          "label": "Color 2",
          "type": "color"
        },
        {
          "column": "RGB_3",
          "label": "Color 3",
          "type": "color"
        },
        {
          "column": "Notch"
        },
        {
          "column": "Ghost Cloud"
        },
        {
          "column": "Viz Notes",
          "display": "note"
        },
        {
          "column": "CS Panels",
          "display": "note"
        }
      ]
    },
    "lighting": {
      "title": "Lighting",
      "fields": [
        {
          "source": "tempo",
          "label": "Tempo",
          "display": "token"
        },
        {
          "column": "Lasers"
        },
        {
          "column": "Lighting Notes",
          "display": "note"
        },
        {
          "column": "Notch"
        },
        {
          "column": "RGB_1",
          "label": "Color 1",
          "type": "color"
        },
        {
          "column": "RGB_2",
          "label": "Color 2",
          "type": "color"
        },
        {
          "column": "RGB_3",
          "label": "Color 3",
          "type": "color"
        },
        {
          "column": "Automation"
        }
      ]
    },
    "session": {
      "title": "Session",
      "system": true
    },
    "admin": {
      "title": "Admin",
      "system": true
    }
  }
}
