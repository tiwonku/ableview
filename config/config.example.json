{
  "ingest": {
    "oscListenPort": 11001,
    "oscSendPort": 11000,
    "abletonHost": "127.0.0.1",
    "watchedTracks": [
      "Cue"
    ],
    "authoritative": {
      "strategy": "track",
      "track": "Cue"
    }
  },
  "sim": {
    "enabled": false,
    "mode": "internal",
    "driver": "scenario",
    "scenario": "./config/scenarios/sheet-demo.json",
    "intervalSeconds": 8,
    "quantDelaySeconds": 1
  },
  "sheets": {
    "worksheet": "MASTER_v1.1",
    "headerRow": 4,
    "matchColumn": "Song Title",
    "aliasColumn": "Aliases",
    "refreshSeconds": 30,
    "cacheFile": "./data/sheet-cache.json",
    "editorColumns": {
      "BPM": { "type": "number", "step": 0.1 },
      "Cue": { "type": "icon", "true": "✅", "false": "✖" },
      "Pillar": { "type": "icon", "true": "✅", "false": "✖" },
      "RGB_1": { "type": "color" },
      "RGB_2": { "type": "color" },
      "RGB_3": { "type": "color" }
    }
  },
  "match": {
    "threshold": 0.4,
    "normalize": {
      "lowercase": true,
      "stripPunctuation": true,
      "stripVersionTags": true
    }
  },
  "server": {
    "wsHeartbeatSeconds": 5
  },
  "views": {
    "band": {
      "title": "Band",
      "fields": [
        {
          "column": "Key"
        },
        {
          "column": "Relative Key"
        },
        {
          "column": "BPM"
        }
      ]
    },
    "visuals": {
      "title": "Visuals",
      "fields": [
        {
          "column": "Video World"
        },
        {
          "column": "Color_Desc_Derek",
          "label": "Color Description"
        },
        {
          "column": "RGB_1",
          "label": "Color 1",
          "type": "color"
        },
        {
          "column": "RGB_2",
          "label": "Color 2",
          "type": "color"
        },
        {
          "column": "RGB_3",
          "label": "Color 3",
          "type": "color"
        },
        {
          "column": "Notch"
        },
        {
          "column": "Ghost Cloud"
        },
        {
          "column": "Viz Notes"
        },
        {
          "column": "CS Panels"
        }
      ]
    },
    "lighting": {
      "title": "Lighting",
      "fields": [
        {
          "column": "BPM"
        },
        {
          "column": "Lasers"
        },
        {
          "column": "Lighting Notes"
        },
        {
          "column": "Notch"
        },
        {
          "column": "RGB_1",
          "label": "Color 1",
          "type": "color"
        },
        {
          "column": "RGB_2",
          "label": "Color 2",
          "type": "color"
        },
        {
          "column": "RGB_3",
          "label": "Color 3",
          "type": "color"
        },
        {
          "column": "Automation"
        }
      ]
    },
    "admin": {
      "title": "Admin",
      "system": true
    }
  }
}
