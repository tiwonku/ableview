# Secrets — never commit
.env
secrets/*

# Local show config (copy from config/config.example.json)
config/config.json
!secrets/.gitkeep

# Runtime cache (offline sheet snapshot, future waveform cache)
data/*
!data/.gitkeep
*.log

# Shared session logs — pull on any machine
!data/sessions/
!data/sessions/.gitkeep
data/sessions/.active.json
data/sessions/test.jsonl

# Node
node_modules/
npm-debug.log*

# OS / editor noise
.DS_Store
Thumbs.db
