# Copy to .env and fill in. Never commit .env.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json
SHEET_ID=
HTTP_PORT=8080
# Live copy of the session log. Leave both blank to keep the log on this machine only.
# SHOW_CAPTURE_URL=https://example.com/api/show-capture
# SHOW_CAPTURE_SECRET=
# LOG_LEVEL=debug
# Optional file logging (show box). Pair with deploy/logrotate.example on Linux.
# LOG_FILE=./logs/ableview.log
